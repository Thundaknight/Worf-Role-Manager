# ── Required ──────────────────────────────────────────────────────────────────

# Your Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# ID of the channel where Worf posts the self-service panel
SELF_SERVICE_CHANNEL_ID=123456789012345678

# ID of the channel where role requests are sent for admin approval
ADMIN_REQUEST_CHANNEL_ID=123456789012345679

# Role ID assigned to every user who completes the Alliance & In-Game Name form.
# Right-click the role in Server Settings → Roles → Copy Role ID (requires Developer Mode).
# Leave unset or 0 to disable.
SERVER_ROLE_ID=123456789012345680

# ── Optional (defaults shown) ─────────────────────────────────────────────────

# Exact names of the roles on your Discord server that Worf will assign.
# The roles must already exist OR you must give Worf the "Manage Roles" permission
# and place its role above these roles in the server hierarchy.
ADMIRAL_ROLE_ID=123456789012345681
COMMODORE_ROLE_ID=123456789012345682
FIRST_OFFICER_ROLE_ID=123456789012345683
ROE_OFFICER_ROLE_ID=123456789012345684
DIPLOMACY_OFFICER_ROLE_ID=123456789012345685
