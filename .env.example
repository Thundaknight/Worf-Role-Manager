# ── Required ──────────────────────────────────────────────────────────────────

# Your Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# ID of the channel where Worf posts the self-service panel
SELF_SERVICE_CHANNEL_ID=123456789012345678

# ID of the channel where role requests are sent for admin approval
# Slash commands (/addalliance, /addadmiral, /listadmirals) only work here
ADMIN_REQUEST_CHANNEL_ID=123456789012345679

# ID of the channel where admirals and admins manage alliance members
# (Remove Role / Remove Player buttons are posted here)
ADMIRAL_MANAGEMENT_CHANNEL_ID=123456789012345680

# ID of the admin role — tagged on every role request posted to the admin channel
ADMIN_ROLE_ID=123456789012345681

# ID of the Discord category under which temporary approval channels are created
# for Commodore/First Officer/RoE Officer/Diplomacy Officer requests when an
# alliance admiral is registered. Leave 0 to disable (falls back to admin channel).
LEADERSHIP_CATEGORY_ID=123456789012345681

# ── Optional ──────────────────────────────────────────────────────────────────

# Your Discord server (guild) ID. When set, slash commands register instantly
# to that guild. If unset, commands sync globally (can take up to 1 hour).
GUILD_ID=123456789012345682

# Role ID assigned to every user who completes the Alliance & In-Game Name form.
# Leave unset or 0 to disable.
SERVER_ROLE_ID=123456789012345683

# Role IDs for each assignable rank. Right-click the role in Server Settings →
# Roles → Copy Role ID (requires Developer Mode enabled in Discord).
ADMIRAL_ROLE_ID=123456789012345684
COMMODORE_ROLE_ID=123456789012345685
FIRST_OFFICER_ROLE_ID=123456789012345686
ROE_OFFICER_ROLE_ID=123456789012345687
DIPLOMACY_OFFICER_ROLE_ID=123456789012345688
